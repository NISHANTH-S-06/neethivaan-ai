# Production Environment Variables Example
# Copy this to .env (for local testing) or set these in your platform dashboard.

# Application settings
APP_ENV=production
SECRET_KEY=generate-a-secure-random-string-here
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database settings
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/neethivaan
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# AI / External Services
TOGETHER_API_KEY=your_together_api_key
HUGGINGFACE_TOKEN=your_huggingface_token

# Storage (Minio / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=neethivaan
