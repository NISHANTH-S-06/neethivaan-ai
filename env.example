# ========================
# Neethivaan AI - Frontend
# ========================
# Copy this file to .env.local for local development
# In production, set these via your Docker / CI environment

# Backend FastAPI URL (must be reachable from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# InsForge configuration (for SDK features)
NEXT_PUBLIC_INSFORGE_URL=https://7g3ttvdi.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=YOUR_INSFORGE_ANON_KEY

# Application title & meta
NEXT_PUBLIC_APP_NAME=Neethivaan AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Analytics ID
NEXT_PUBLIC_GA_ID=
